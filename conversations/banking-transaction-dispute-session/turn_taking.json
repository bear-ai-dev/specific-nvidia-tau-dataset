{
  "schema_version": "0.1.0",
  "source": "ElevenLabs Scribe v2 word timestamps",
  "warning": "Backchannel and barge-in fields are automatic candidates and require human acceptance for gold labels.",
  "turns": [
    {
      "turn_id": "turn-0001",
      "role": "agent",
      "start_seconds": 0.48,
      "end_seconds": 5.16,
      "text": "Hi, thanks for calling Harvestone Bank. This is Darren. How are you doing and how can I help?",
      "word_count": 18,
      "duration_seconds": 4.68,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0002",
      "role": "customer",
      "start_seconds": 6.34,
      "end_seconds": 19.2,
      "text": "Hey, I'm calling because there's a two hundred and forty-three dollar and eighteen cent charge from a company I've never heard of. I haven't filed anything yet. I'm trying to figure out whether I need to dispute it.",
      "word_count": 44,
      "duration_seconds": 12.86,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0003",
      "role": "agent",
      "start_seconds": 20.96,
      "end_seconds": 27.9,
      "text": "I'm sorry you've had to worry about it. Let's slow down and figure out the charge actually, uh, what it actually is before we take any action. May I have your name and email?",
      "word_count": 37,
      "duration_seconds": 6.94,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0004",
      "role": "customer",
      "start_seconds": 28.92,
      "end_seconds": 34.2,
      "text": "Justin Porter, jporterninety-two@email.com.",
      "word_count": 6,
      "duration_seconds": 5.28,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0005",
      "role": "agent",
      "start_seconds": 35.48,
      "end_seconds": 37.9,
      "text": "Got it. Give me one second.",
      "word_count": 6,
      "duration_seconds": 2.42,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0006",
      "role": "agent",
      "start_seconds": 45.16,
      "end_seconds": 48.32,
      "text": "All right. Could you tell me your billing zip code and month and day of birth?",
      "word_count": 16,
      "duration_seconds": 3.16,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0007",
      "role": "customer",
      "start_seconds": 49.76,
      "end_seconds": 54.7,
      "text": "Six four one one four, February nineteenth.",
      "word_count": 7,
      "duration_seconds": 4.94,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0008",
      "role": "agent",
      "start_seconds": 55.76,
      "end_seconds": 58.44,
      "text": "Awesome. Give me two seconds really quick.",
      "word_count": 7,
      "duration_seconds": 2.68,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0009",
      "role": "agent",
      "start_seconds": 64.36,
      "end_seconds": 70.02,
      "text": "All right. You're verified. Uh, do you recognize the amount, date, or city even if the merchant name is unfamiliar?",
      "word_count": 21,
      "duration_seconds": 5.66,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0010",
      "role": "customer",
      "start_seconds": 71.48,
      "end_seconds": 96.94,
      "text": "I recognize the amount because it's right there on my statement, but I don't recognize anything buying a- anything for two hundred and forty-three dollars and eighteen cents. It posted Monday. There's no city listed, and the description says MRKTPLC star eight four seven two.",
      "word_count": 49,
      "duration_seconds": 25.46,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0011",
      "role": "agent",
      "start_seconds": 99.6,
      "end_seconds": 104.14,
      "text": "Okay, give me one moment to retrieve those transactions.",
      "word_count": 9,
      "duration_seconds": 4.54,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0012",
      "role": "agent",
      "start_seconds": 133.1,
      "end_seconds": 146.16,
      "text": "All right, Justin. Uh, I found the transactions on the card ending nine one zero two. The merchant category is online marketplace, and it posted after a smaller one dollar authorization. Did you purchase anything online recently?",
      "word_count": 37,
      "duration_seconds": 13.06,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0013",
      "role": "customer",
      "start_seconds": 148.1,
      "end_seconds": 151.9,
      "text": "No, I did not buy anything for two hundred and forty-three dollars.",
      "word_count": 13,
      "duration_seconds": 3.8,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0014",
      "role": "agent",
      "start_seconds": 152.74,
      "end_seconds": 154.7,
      "text": "Well, is the physical card in your possession still?",
      "word_count": 9,
      "duration_seconds": 1.96,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0015",
      "role": "customer",
      "start_seconds": 155.76,
      "end_seconds": 156.98,
      "text": "Yes, in my wallet.",
      "word_count": 4,
      "duration_seconds": 1.22,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0016",
      "role": "agent",
      "start_seconds": 158.08,
      "end_seconds": 158.34,
      "text": "Okay.",
      "word_count": 1,
      "duration_seconds": 0.26,
      "is_backchannel_candidate": true
    },
    {
      "turn_id": "turn-0017",
      "role": "agent",
      "start_seconds": 162.78,
      "end_seconds": 166.56,
      "text": "Did anyone in your household use the card or a saved wallet perhaps?",
      "word_count": 13,
      "duration_seconds": 3.78,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0018",
      "role": "customer",
      "start_seconds": 167.68,
      "end_seconds": 172.18,
      "text": "My daughter has used the marketplace, but not my card. I'll ask her now.",
      "word_count": 15,
      "duration_seconds": 4.5,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0019",
      "role": "agent",
      "start_seconds": 172.82,
      "end_seconds": 183.5,
      "text": "Yes. Uh, please ask your daughter whether she used a saved card, but don't call any phone number shown in a suspicious transaction description, please. While she checks, I'll review the bank's current unauthorized transaction procedure.",
      "word_count": 39,
      "duration_seconds": 10.68,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0020",
      "role": "agent",
      "start_seconds": 187.64,
      "end_seconds": 200.64,
      "text": "Okay, hold on one second. The policy says to review household and digital wallet activity, then submit the dispute through the secure tool. Filing does not guarantee provisional credit, and investigation timing depends on the transaction type.",
      "word_count": 37,
      "duration_seconds": 13.0,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0021",
      "role": "agent",
      "start_seconds": 202.36,
      "end_seconds": 205.16,
      "text": "So I'll search it up really quick.",
      "word_count": 8,
      "duration_seconds": 2.8,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0022",
      "role": "customer",
      "start_seconds": 207.48,
      "end_seconds": 208.62,
      "text": "Can you just remove it?",
      "word_count": 5,
      "duration_seconds": 1.14,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0023",
      "role": "agent",
      "start_seconds": 211.38,
      "end_seconds": 218.94,
      "text": "You know, I can't erase a posted charge, but I can send the secure dispute form from this injec-- transaction. Uh, would you like me to open it for you?",
      "word_count": 31,
      "duration_seconds": 7.56,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0024",
      "role": "customer",
      "start_seconds": 219.96,
      "end_seconds": 223.56,
      "text": "Yes, please. I'd rather have it ready while I'm checking with my daughter.",
      "word_count": 15,
      "duration_seconds": 3.6,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0025",
      "role": "agent",
      "start_seconds": 224.36,
      "end_seconds": 226.3,
      "text": "All right. Give me one moment while I open it, okay?",
      "word_count": 11,
      "duration_seconds": 1.94,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0026",
      "role": "agent",
      "start_seconds": 228.76,
      "end_seconds": 240.54,
      "text": "All right, it's ready. It's online banking. Look for review transaction ending eight four seven two. You'll review the details and submit it yourself if the purchase was not authorized.",
      "word_count": 33,
      "duration_seconds": 11.78,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0027",
      "role": "customer",
      "start_seconds": 240.6,
      "end_seconds": 245.72,
      "text": "Okay, wait. I see it. It's, it asks whether I contacted the merchant.",
      "word_count": 14,
      "duration_seconds": 5.12,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0028",
      "role": "agent",
      "start_seconds": 253.06,
      "end_seconds": 259.75,
      "text": "Okay. Answer accurately. If you determine your daughter made the purchase, stop before submitting and resolve it with her. If you did not authorize it, complete the form.",
      "word_count": 28,
      "duration_seconds": 6.69,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0029",
      "role": "customer",
      "start_seconds": 260.959,
      "end_seconds": 265.08,
      "text": "It also asks if I want a representative.",
      "word_count": 8,
      "duration_seconds": 4.121,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0030",
      "role": "agent",
      "start_seconds": 267.4,
      "end_seconds": 272.4,
      "text": "Yeah, you can request one. If the tool fails or you need an accommodation, I can transfer you with the reason attached.",
      "word_count": 22,
      "duration_seconds": 5.0,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0031",
      "role": "customer",
      "start_seconds": 273.92,
      "end_seconds": 277.8,
      "text": "Okay. I can finish it myself, but what happens after submit?",
      "word_count": 11,
      "duration_seconds": 3.88,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0032",
      "role": "agent",
      "start_seconds": 279.48,
      "end_seconds": 287.46,
      "text": "You should receive a claim reference and written timing disclosures in secure messages. Keep any receipts or com-communications for yourself.",
      "word_count": 21,
      "duration_seconds": 7.98,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0033",
      "role": "agent",
      "start_seconds": 294.18,
      "end_seconds": 300.46,
      "text": "Additionally, I can confirm the dispute session if it was issued, but no claim is recorded until you press submit.",
      "word_count": 20,
      "duration_seconds": 6.28,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0034",
      "role": "customer",
      "start_seconds": 300.54,
      "end_seconds": 305.26,
      "text": "That's clear. Let me call my daughter first, then finish it if needed.",
      "word_count": 14,
      "duration_seconds": 4.72,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0035",
      "role": "agent",
      "start_seconds": 306.54,
      "end_seconds": 307.7,
      "text": "Yes, that would be the next step.",
      "word_count": 7,
      "duration_seconds": 1.16,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0036",
      "role": "customer",
      "start_seconds": 309.9,
      "end_seconds": 313.12,
      "text": "Okay, my daughter is calling me back now. Can you hold?",
      "word_count": 11,
      "duration_seconds": 3.22,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0037",
      "role": "agent",
      "start_seconds": 313.18,
      "end_seconds": 313.92,
      "text": "Yes, absolutely.",
      "word_count": 2,
      "duration_seconds": 0.74,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0038",
      "role": "agent",
      "start_seconds": 316.02,
      "end_seconds": 321.5,
      "text": "Keep the dispute page open, but do not press submit until you know whether or not anyone authorized the purchase.",
      "word_count": 20,
      "duration_seconds": 5.48,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0039",
      "role": "customer",
      "start_seconds": 345.84,
      "end_seconds": 352.66,
      "text": "Okay, I'm back. She says she bought a patio set, but she swears she used her own card.",
      "word_count": 19,
      "duration_seconds": 6.82,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0040",
      "role": "agent",
      "start_seconds": 352.74,
      "end_seconds": 362.84,
      "text": "Ask her whether or not the card is ending in nine one zero two and if it was saved in the marketplace wallet. Sometimes the checkout screen defaults to a previously stored payment method and, you know, you end up using that.",
      "word_count": 42,
      "duration_seconds": 10.1,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0041",
      "role": "customer",
      "start_seconds": 363.848,
      "end_seconds": 368.748,
      "text": "Okay. Wait, I just texted her. She's checking. This is embarrassing.",
      "word_count": 12,
      "duration_seconds": 4.9,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0042",
      "role": "agent",
      "start_seconds": 371.728,
      "end_seconds": 378.348,
      "text": "No, no, it's useful information. A known household purchase should not be reported as fraud merely because the descriptor was unfamiliar.",
      "word_count": 22,
      "duration_seconds": 6.62,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0043",
      "role": "customer",
      "start_seconds": 379.248,
      "end_seconds": 385.328,
      "text": "She found it. The receipt shows my last four digits. She just clicked too fast when checking out.",
      "word_count": 18,
      "duration_seconds": 6.08,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0044",
      "role": "agent",
      "start_seconds": 387.348,
      "end_seconds": 394.708,
      "text": "Okay. Got it. That's good. Then don't submit the unauthorized transaction claim. You can work out repayment with her or ask the merchant whether its return policy applies.",
      "word_count": 30,
      "duration_seconds": 7.36,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0045",
      "role": "customer",
      "start_seconds": 396.168,
      "end_seconds": 398.008,
      "text": "Can you cancel the dispute tool?",
      "word_count": 6,
      "duration_seconds": 1.84,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0046",
      "role": "agent",
      "start_seconds": 403.288,
      "end_seconds": 411.848,
      "text": "No claim exists yet, but as you did not submit, uh, you may close the session. The tool log will show that it was issued, not that the transaction was disputed.",
      "word_count": 31,
      "duration_seconds": 8.56,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0047",
      "role": "customer",
      "start_seconds": 413.198,
      "end_seconds": 414.238,
      "text": "Will that hurt me later?",
      "word_count": 5,
      "duration_seconds": 1.04,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0048",
      "role": "agent",
      "start_seconds": 415.368,
      "end_seconds": 423.768,
      "text": "Uh, no, it should not. If you later discover a genuinely unauthorized transaction, contact us immediately. Uh, today's unused session does not waive your rights at all.",
      "word_count": 28,
      "duration_seconds": 8.4,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0049",
      "role": "customer",
      "start_seconds": 425.148,
      "end_seconds": 428.788,
      "text": "Okay. I appreciate that you made me check before filing.",
      "word_count": 10,
      "duration_seconds": 3.64,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0050",
      "role": "agent",
      "start_seconds": 431.148,
      "end_seconds": 439.348,
      "text": "Yes. The policy is designated or designed to separate merchant confusion, household use, and actual unauthorized activity. Each can require a different remedy.",
      "word_count": 23,
      "duration_seconds": 8.2,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0051",
      "role": "customer",
      "start_seconds": 440.628,
      "end_seconds": 442.768,
      "text": "Should I remove my card from her account?",
      "word_count": 8,
      "duration_seconds": 2.14,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0052",
      "role": "agent",
      "start_seconds": 445.128,
      "end_seconds": 451.618,
      "text": "That's a sensible security step you can take with the marketplace, but also review your own digital wallets and saved payment se- settings.",
      "word_count": 24,
      "duration_seconds": 6.49,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0053",
      "role": "customer",
      "start_seconds": 451.648,
      "end_seconds": 455.948,
      "text": "So the final... Oh, okay. So the final outcome is no bank dispute?",
      "word_count": 13,
      "duration_seconds": 4.3,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0054",
      "role": "agent",
      "start_seconds": 457.348,
      "end_seconds": 463.468,
      "text": "Correct. Yes. Transaction identified as a household purchase, dispute session not submitted, and no change made to the card account.",
      "word_count": 20,
      "duration_seconds": 6.12,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0055",
      "role": "customer",
      "start_seconds": 464.608,
      "end_seconds": 468.667,
      "text": "Okay. That makes sense. I'm glad we figured it out before I filed anything.",
      "word_count": 15,
      "duration_seconds": 4.059,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0056",
      "role": "agent",
      "start_seconds": 469.568,
      "end_seconds": 472.548,
      "text": "Yes, of course. Me too. Is there anything else I can help you with?",
      "word_count": 14,
      "duration_seconds": 2.98,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0057",
      "role": "customer",
      "start_seconds": 473.548,
      "end_seconds": 475.348,
      "text": "No, that's it. Thanks for walking me through it.",
      "word_count": 10,
      "duration_seconds": 1.8,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0058",
      "role": "agent",
      "start_seconds": 476.048,
      "end_seconds": 479.588,
      "text": "Yeah, of course. You're welcome. Thanks for calling Harvestone Bank, and please take care.",
      "word_count": 15,
      "duration_seconds": 3.54,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0059",
      "role": "agent",
      "start_seconds": 481.508,
      "end_seconds": 481.808,
      "text": "Bye-bye.",
      "word_count": 2,
      "duration_seconds": 0.3,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0060",
      "role": "customer",
      "start_seconds": 483.348,
      "end_seconds": 483.648,
      "text": "All right. Bye-bye.",
      "word_count": 4,
      "duration_seconds": 0.3,
      "is_backchannel_candidate": false
    }
  ],
