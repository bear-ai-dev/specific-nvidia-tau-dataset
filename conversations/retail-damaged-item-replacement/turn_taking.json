      "role": "customer",
      "start_seconds": 467.34,
      "end_seconds": 472.28,
      "text": "Yeah, me too. I hope it goes better. All right, no, thank you so much for your time.",
      "word_count": 18,
      "duration_seconds": 4.94,
      "is_backchannel_candidate": false
    },
