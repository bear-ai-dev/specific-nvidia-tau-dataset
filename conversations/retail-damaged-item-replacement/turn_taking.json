      "turn_id": "turn-0048",
      "role": "agent",
      "start_seconds": 389.42,
      "end_seconds": 395.5,
      "text": "Perfect. Yeah, that's the one, and, uh, you'll see the optional photo link, uh, farther down in the email.",
      "word_count": 21,
      "duration_seconds": 6.08,
      "is_backchannel_candidate": false
    },
