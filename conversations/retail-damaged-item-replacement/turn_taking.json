      "role": "agent",
      "start_seconds": 365.22,
      "end_seconds": 369.34,
      "text": "Um, let me refresh that, actually. One second.",
      "word_count": 8,
      "duration_seconds": 4.12,
      "is_backchannel_candidate": false
    },
