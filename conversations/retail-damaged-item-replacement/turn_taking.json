      "turn_id": "turn-0045",
      "role": "agent",
      "start_seconds": 372.3,
      "end_seconds": 379.74,
      "text": "Okay, yeah, um, it says it was just sent, and the subject line for this will start with, \"Your Westline replacement.\"",
      "word_count": 21,
      "duration_seconds": 7.44,
      "is_backchannel_candidate": false
