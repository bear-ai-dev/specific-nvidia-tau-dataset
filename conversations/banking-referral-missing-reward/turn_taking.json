    {
      "turn_id": "turn-0002",
      "role": "customer",
      "start_seconds": 1.7,
      "end_seconds": 13.68,
      "text": "Hi, I referred my sister for one of your cards. She was approved, and the hundred dollar bonus never showed up. Honestly, a little annoyed. I've checked the app three times, and it just keeps saying pending.",
      "word_count": 38,
      "duration_seconds": 11.98,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0003",
      "role": "agent",
      "start_seconds": 15.46,
      "end_seconds": 21.96,
      "text": "I see. I can completely get why that's frustrating. Let's pull up the referral and see exactly where it's getting held up. May I have your full name?",
      "word_count": 31,
      "duration_seconds": 6.5,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0004",
      "role": "customer",
      "start_seconds": 23.1,
      "end_seconds": 30.02,
      "text": "Daniel Brooks. Brooks, B as in Boston, R-O-O-K-S.",
      "word_count": 12,
      "duration_seconds": 6.92,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0005",
      "role": "agent",
      "start_seconds": 32.16,
      "end_seconds": 34.58,
      "text": "Awesome. Thank you. What email address is on your profile?",
      "word_count": 10,
      "duration_seconds": 2.42,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0006",
      "role": "customer",
      "start_seconds": 36.62,
      "end_seconds": 41.02,
      "text": "Daniel.Brooks17@gmail.com.",
      "word_count": 4,
      "duration_seconds": 4.4,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0007",
      "role": "agent",
      "start_seconds": 43.04,
      "end_seconds": 46.56,
      "text": "Okay. Uh, just give me a moment while I pull that up.",
      "word_count": 12,
      "duration_seconds": 3.52,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0008",
      "role": "agent",
      "start_seconds": 57.16,
      "end_seconds": 68.76,
      "text": "All right. I'm recording the verification time, uh, at nine zero nine AM, uh, the twenty-eighth of August, twenty twenty-six. I'll ask two questions from your profile. Please don't provide a full card number, okay?",
      "word_count": 40,
      "duration_seconds": 11.6,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0009",
      "role": "customer",
      "start_seconds": 70.28,
      "end_seconds": 71.02,
      "text": "Yeah, go ahead.",
      "word_count": 3,
      "duration_seconds": 0.74,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0010",
      "role": "agent",
      "start_seconds": 76.62,
      "end_seconds": 83.02,
      "text": "What is your billing zip and the month and day of birth?",
      "word_count": 12,
      "duration_seconds": 6.4,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0011",
      "role": "customer",
      "start_seconds": 84.94,
      "end_seconds": 89.86,
      "text": "Two seven six zero nine, October twelfth.",
      "word_count": 7,
      "duration_seconds": 4.92,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0012",
      "role": "agent",
      "start_seconds": 94.92,
      "end_seconds": 95.18,
      "text": "Hello?",
      "word_count": 1,
      "duration_seconds": 0.26,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0013",
      "role": "customer",
      "start_seconds": 98.08,
      "end_seconds": 102.06,
      "text": "Two seven six zero nine, October twelfth.",
      "word_count": 7,
      "duration_seconds": 3.98,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0014",
      "role": "agent",
      "start_seconds": 106.68,
      "end_seconds": 109.8,
      "text": "All right, I'm checking that now. This may take a few seconds, okay?",
      "word_count": 14,
      "duration_seconds": 3.12,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0015",
      "role": "agent",
      "start_seconds": 131,
      "end_seconds": 133.74,
      "text": "All right, thanks. You're verified. About when did your sister apply?",
      "word_count": 12,
      "duration_seconds": 2.74,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0016",
      "role": "customer",
      "start_seconds": 135.04,
      "end_seconds": 141.16,
      "text": "August third. Her name is Elisa Brooks. She got the card maybe ten days ago.",
      "word_count": 15,
      "duration_seconds": 6.12,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0017",
      "role": "agent",
      "start_seconds": 142.84,
      "end_seconds": 145.58,
      "text": "Okay, let me look at what the system has on that.",
      "word_count": 11,
      "duration_seconds": 2.74,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0018",
      "role": "agent",
      "start_seconds": 147.5,
      "end_seconds": 150.92,
      "text": "I see an invitation sent August second to an email beginning",
      "word_count": 11,
      "duration_seconds": 3.42,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0019",
      "role": "agent",
      "start_seconds": 152.36,
      "end_seconds": 157.12,
      "text": "a Brooks. The referral status says approved. Purchase requirement pending.",
      "word_count": 10,
      "duration_seconds": 4.76,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0020",
      "role": "customer",
      "start_seconds": 158.44,
      "end_seconds": 160.68,
      "text": "She told me she used it for groceries.",
      "word_count": 8,
      "duration_seconds": 2.24,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0021",
      "role": "agent",
      "start_seconds": 165.14,
      "end_seconds": 173.1,
      "text": "The referral record does not show her private transactions. Uh, I'm going to check the published terms for what qualifies and when the reward posts.",
      "word_count": 26,
      "duration_seconds": 7.96,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0022",
      "role": "agent",
      "start_seconds": 177.64,
      "end_seconds": 179.94,
      "text": "Okay, hang on one second while I update it for you. Okay.",
      "word_count": 12,
      "duration_seconds": 2.3,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0023",
      "role": "agent",
      "start_seconds": 198.42,
      "end_seconds": 205.769,
      "text": "The current terms require the referred customer to make a qualifying purchase within ninety days. The bonus can take up to two billing cycles after that purchase posts.",
      "word_count": 28,
      "duration_seconds": 7.349,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0024",
      "role": "customer",
      "start_seconds": 207.74,
      "end_seconds": 214.08,
      "text": "Two billing cycles? The banner made it sound immediate. I thought I would have gotten it by now.",
      "word_count": 18,
      "duration_seconds": 6.34,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0025",
      "role": "agent",
      "start_seconds": 214.16,
      "end_seconds": 220.54,
      "text": "I understand why that feels slow, but approval alone does not trigger the reward, and I cannot see or disclose your sister's purchase history from your account.",
      "word_count": 28,
      "duration_seconds": 6.38,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0026",
      "role": "customer",
      "start_seconds": 223.62,
      "end_seconds": 226.7,
      "text": "Can you at least tell me if the hundred dollars is still the offer?",
      "word_count": 14,
      "duration_seconds": 3.08,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0027",
      "role": "agent",
      "start_seconds": 228.48,
      "end_seconds": 230.5,
      "text": "Okay, yeah. Give me just a moment while I pull that up, okay?",
      "word_count": 13,
      "duration_seconds": 2.02,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0028",
      "role": "agent",
      "start_seconds": 241.28,
      "end_seconds": 249.8,
      "text": "Yes. Your invitation was created under the one hundred dollar statement credit offer. If her qualifying purchase posted, the deadline has not passed.",
      "word_count": 23,
      "duration_seconds": 8.52,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0029",
      "role": "customer",
      "start_seconds": 249.92,
      "end_seconds": 252.52,
      "text": "How am I supposed to track it without calling every week?",
      "word_count": 11,
      "duration_seconds": 2.6,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0030",
      "role": "agent",
      "start_seconds": 253.7,
      "end_seconds": 262.68,
      "text": "I can send you a refers, uh, referral status tool. It shows invite approval, qualification, and reward posting stages without exposing your sister's account details.",
      "word_count": 26,
      "duration_seconds": 8.98,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0031",
      "role": "agent",
      "start_seconds": 265.7,
      "end_seconds": 268.24,
      "text": "All right, I'm gonna check that now. This may take a few seconds, okay?",
      "word_count": 15,
      "duration_seconds": 2.54,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0032",
      "role": "agent",
      "start_seconds": 277.74,
      "end_seconds": 280.14,
      "text": "Okay. I just sent the tracker to your secure message center.",
      "word_count": 11,
      "duration_seconds": 2.4,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0033",
      "role": "customer",
      "start_seconds": 281.98,
      "end_seconds": 283.34,
      "text": "Okay, I'm opening it.",
      "word_count": 5,
      "duration_seconds": 1.36,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0034",
      "role": "customer",
      "start_seconds": 285.88,
      "end_seconds": 291.76,
      "text": "It says purchase qualification pending. So that's the same thing you see?",
      "word_count": 13,
      "duration_seconds": 5.88,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0035",
      "role": "agent",
      "start_seconds": 292.5,
      "end_seconds": 302.5,
      "text": "Correct. If it remains pending after two billing cycles from her purchase, contact us again and reference referral RF8241.",
      "word_count": 19,
      "duration_seconds": 10.0,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0036",
      "role": "customer",
      "start_seconds": 304,
      "end_seconds": 305.26,
      "text": "Can you email the link too?",
      "word_count": 6,
      "duration_seconds": 1.26,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0037",
      "role": "agent",
      "start_seconds": 306.8,
      "end_seconds": 314.02,
      "text": "For security, the working tool stays inside online banking. Uh, I can send an email notification telling you a secure message is waiting.",
      "word_count": 23,
      "duration_seconds": 7.22,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0038",
      "role": "customer",
      "start_seconds": 315.84,
      "end_seconds": 316.68,
      "text": "Okay, do that.",
      "word_count": 3,
      "duration_seconds": 0.84,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0039",
      "role": "agent",
      "start_seconds": 320.88,
      "end_seconds": 332.52,
      "text": "Done. All right. To recap, the referral is attached to the one hundred dollar offer. Approval is recorded, purchase qualification is still pending, and the reward may take up to two billing cycles after a qualifying purchase posts.",
      "word_count": 38,
      "duration_seconds": 11.64,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0040",
      "role": "customer",
      "start_seconds": 334.68,
      "end_seconds": 337.26,
      "text": "All right. At least I know it didn't disappear.",
      "word_count": 10,
      "duration_seconds": 2.58,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0041",
      "role": "agent",
      "start_seconds": 338.46,
      "end_seconds": 342.36,
      "text": "Exactly. I hope that's the case. Uh, keep the tracker and reference number. Is there anything else?",
      "word_count": 18,
      "duration_seconds": 3.9,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0042",
      "role": "customer",
      "start_seconds": 344.24,
      "end_seconds": 354.36,
      "text": "Um, no, that's pretty much it. I'm looking at the tracker now. Does pending mean Elisa did something wrong or that she hasn't paid her balance this cycle yet?",
      "word_count": 32,
      "duration_seconds": 10.12,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0043",
      "role": "agent",
      "start_seconds": 355.62,
      "end_seconds": 369.02,
      "text": "Not necessarily. Uh, it can mean the qualifying purchase has not posted, the referral match is still processing, or the reward window has not reached its posting stage. The tracker deliberately does not reveal which purchases she made.",
      "word_count": 38,
      "duration_seconds": 13.4,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0044",
      "role": "customer",
      "start_seconds": 370.51,
      "end_seconds": 377.79,
      "text": "She used a different email on the application than the one I invite- invited. Could that break the match?",
      "word_count": 19,
      "duration_seconds": 7.28,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0045",
      "role": "agent",
      "start_seconds": 379.99,
      "end_seconds": 395.49,
      "text": "It could delay automated matching. The referral record already shows approved, uh, so the application was associated successfully. I would not ask her to reapply, uh, but she should duplicate applications to create a different problem.",
      "word_count": 36,
      "duration_seconds": 15.5,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0046",
      "role": "customer",
      "start_seconds": 397.51,
      "end_seconds": 400.01,
      "text": "Okay. Yeah. Because she was about to try it again.",
      "word_count": 10,
      "duration_seconds": 2.5,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0047",
      "role": "agent",
      "start_seconds": 401.44,
      "end_seconds": 409.06,
      "text": "Yeah. Please tell her not to. She should use her own secure account for questions about her card. I can discuss her reward, but not her balance, purchases, or approved details.",
      "word_count": 31,
      "duration_seconds": 7.62,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0048",
      "role": "customer",
      "start_seconds": 410.83,
      "end_seconds": 415.29,
      "text": "Understood. The tracker has a little question mark next to qualifying purchase.",
      "word_count": 12,
      "duration_seconds": 4.46,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0049",
      "role": "agent",
      "start_seconds": 416.67,
      "end_seconds": 418.57,
      "text": "Open that description and read the first sentence to me.",
      "word_count": 10,
      "duration_seconds": 1.9,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0050",
      "role": "customer",
      "start_seconds": 419.89,
      "end_seconds": 426.65,
      "text": "It says, \"Purchases must be eligible and fully posted, not returned or cash-like.\"",
      "word_count": 14,
      "duration_seconds": 6.76,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0051",
      "role": "agent",
      "start_seconds": 427.31,
      "end_seconds": 432.75,
      "text": "Correct. Cash advances, balance transfers, fees, and return purchases do not qualify under the terms I found.",
      "word_count": 17,
      "duration_seconds": 5.44,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0052",
      "role": "customer",
      "start_seconds": 434.21,
      "end_seconds": 438.01,
      "text": "She bought gro- groceries, so that sounds eligible.",
      "word_count": 8,
      "duration_seconds": 3.8,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0053",
      "role": "agent",
      "start_seconds": 440.09,
      "end_seconds": 447.95,
      "text": "It generally would, uh, assuming it posted to the referred account within the offer window. I still cannot certify her private transaction from your profile.",
      "word_count": 25,
      "duration_seconds": 7.86,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0054",
      "role": "customer",
      "start_seconds": 449.03,
      "end_seconds": 451.17,
      "text": "Fair. Can you give me the dates again?",
      "word_count": 8,
      "duration_seconds": 2.14,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0055",
      "role": "agent",
      "start_seconds": 452.77,
      "end_seconds": 465.21,
      "text": "Invitation August second. Application approval is recorded. The qualifying purchase stage remains pending after an eligible purchase post. Allow up to two billing cycles for the one hundred dollar statement credit.",
      "word_count": 31,
      "duration_seconds": 12.44,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0056",
      "role": "customer",
      "start_seconds": 466.67,
      "end_seconds": 468.39,
      "text": "And December isn't the deadline?",
      "word_count": 6,
      "duration_seconds": 1.72,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0057",
      "role": "agent",
      "start_seconds": 469.19,
      "end_seconds": 474.87,
      "text": "The tracker will show that the actual deadline tied to the invitation. Use that date rather than estimating from today, please.",
      "word_count": 21,
      "duration_seconds": 5.68,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0058",
      "role": "customer",
      "start_seconds": 475.99,
      "end_seconds": 481.75,
      "text": "All right. Sorry. Someone just walked into my office. I'm writing to her. Don't reapply.",
      "word_count": 17,
      "duration_seconds": 5.76,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0059",
      "role": "agent",
      "start_seconds": 483.09,
      "end_seconds": 488.77,
      "text": "That is correct. Okay. Please keep referral RF eight two",
      "word_count": 10,
      "duration_seconds": 5.68,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0060",
      "role": "agent",
      "start_seconds": 489.97,
      "end_seconds": 493.03,
      "text": "four one and check the secure tracker for more updates.",
      "word_count": 10,
      "duration_seconds": 3.06,
      "is_backchannel_candidate": false
    },
    {
      "turn_id": "turn-0061",
      "role": "agent",
      "start_seconds": 494.73,
      "end_seconds": 495.09,
      "text": "Thank you.",
      "word_count": 2,
      "duration_seconds": 0.36,
      "is_backchannel_candidate": true
    }
