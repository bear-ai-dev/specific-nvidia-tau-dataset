    {
      "turn_id": "turn-0096",
      "role": "agent",
      "start_seconds": 580.9,
      "end_seconds": 592.56,
      "text": "Yeah, totally fair. Keep an eye out on the usage screen for the next day. If the number keeps climbing while the phone is idle, call us back and we'll investigate further.",
      "word_count": 33,
