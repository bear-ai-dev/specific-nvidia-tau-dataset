{
  "schema_version": "0.2.0",
  "registry_name": "banking",
  "registry_version": "0.2.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Stable entity reads and consequential business mutations; source narration labels are normalized rather than copied one-for-one.",
  "tools": [
    {
      "name": "lookup_customer",
      "description": "Find one banking customer using a stable customer identifier or verified profile attribute.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Customer account identifier."
          },
          "full_name": {
            "type": "string",
            "description": "Customer full name."
          },
          "email": {
            "type": "string",
            "description": "Email on the profile.",
            "format": "email"
          },
          "account_match": {
            "type": "string",
            "description": "Trusted calling-channel match when available.",
            "enum": [
              "caller_phone"
            ]
          },
          "billing_zip": {
            "type": "string",
            "description": "Billing ZIP collected for the lookup or verification."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits collected for the lookup or verification.",
            "pattern": "^[0-9]{4}$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Stable customer identifier."
          },
          "match": {
            "type": "string",
            "description": "Lookup outcome."
          },
          "full_name": {
            "type": "string",
            "description": "Customer display name."
          },
          "required_verification_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trusted_channels": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "customer_id",
          "match"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_current_time",
      "description": "Return the authoritative current timestamp for an audit or verification record.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Whether authoritative time was available."
          },
          "timestamp": {
            "type": "string",
            "description": "RFC 3339 timestamp when available."
          },
          "timezone": {
            "type": "string",
            "description": "Authoritative timezone when available."
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "verify_customer_identity",
      "description": "Validate supplied non-secret identity factors against the resolved profile and return a scoped verification record. Collecting or naming factors alone never establishes success.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "billing_zip": {
            "type": "string",
            "description": "Billing ZIP supplied by the customer."
          },
          "mobile_last4": {
            "type": "string",
            "description": "Last four digits of the registered mobile number.",
            "pattern": "^[0-9]{4}$"
          },
          "card_last4": {
            "type": "string",
            "description": "Last four digits of the card used as a permitted verification factor.",
            "pattern": "^[0-9]{4}$"
          },
          "birth_month_day": {
            "type": "string",
            "description": "Customer-supplied birth month and day, without requiring the full date."
          },
          "verified_at": {
            "type": "string",
            "description": "Authoritative verification timestamp when available."
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "verification_id": {
            "type": "string",
            "description": "Scoped verification record."
          },
          "status": {
            "type": "string",
            "description": "Verification outcome."
          },
          "matched_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified_at": {
            "type": "string",
            "description": "Verification timestamp when available."
          }
        },
        "required": [
          "verification_id",
          "status",
          "matched_methods"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "start_trusted_channel_confirmation",
      "description": "Send a purpose-bound confirmation challenge to an already trusted masked channel. The agent must not request or place the secret response in ordinary tool arguments.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "purpose": {
            "type": "string",
            "description": "Confirmation purpose.",
            "enum": [
              "email_change"
            ]
          },
          "channel": {
            "type": "string",
            "description": "Trusted channel to use.",
            "enum": [
              "sms",
              "secure_message"
            ]
          },
          "verification_id": {
            "type": "string",
            "description": "Active identity-verification record."
          }
        },
        "required": [
          "customer_id",
          "purpose",
          "channel",
          "verification_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "confirmation_id": {
            "type": "string",
            "description": "Purpose-bound confirmation record."
          },
          "status": {
            "type": "string",
            "description": "Challenge delivery state."
          },
          "masked_destination": {
            "type": "string",
            "description": "Masked trusted destination."
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration time when available."
          }
        },
        "required": [
          "confirmation_id",
          "status",
          "masked_destination"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_trusted_channel_confirmation",
      "description": "Read the current state of a purpose-bound trusted-channel challenge without receiving or exposing the secret response.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "confirmation_id": {
            "type": "string",
            "description": "Confirmation record returned when the challenge was started."
          }
        },
        "required": [
          "customer_id",
          "confirmation_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "confirmation_id": {
            "type": "string",
            "description": "Purpose-bound confirmation record."
          },
          "status": {
            "type": "string",
            "description": "Current verification state."
          },
          "verified_at": {
            "type": "string",
            "description": "Confirmation time when available."
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration time when available."
          }
        },
        "required": [
          "confirmation_id",
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "update_customer_email",
      "description": "Change the email on a verified customer profile after the required confirmation flow succeeds.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "new_email": {
            "type": "string",
            "description": "New customer email.",
            "format": "email"
          },
          "verification_id": {
            "type": "string",
            "description": "Active identity-verification record."
          },
          "confirmation_id": {
            "type": "string",
            "description": "Successful trusted-channel confirmation record."
          }
        },
        "required": [
          "customer_id",
          "new_email",
          "verification_id",
          "confirmation_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Mutation outcome."
          },
          "primary_email": {
            "type": "string",
            "description": "New primary email."
          },
          "notification_email": {
            "type": "string",
            "description": "Current notification email."
          },
          "login_identifier_changed": {
            "type": "boolean",
            "description": "Whether the login identifier changed."
          },
          "transition_security_notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "status",
          "primary_email"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "search_policy_knowledge",
      "description": "Search current product or policy knowledge. Search mode is an argument, not a separate business function.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Plain-language policy or product question."
          },
          "search_mode": {
            "type": "string",
            "description": "Retrieval strategy.",
            "enum": [
              "keyword",
              "semantic"
            ]
          },
          "as_of": {
            "type": "string",
            "description": "Optional date or timestamp for time-sensitive terms."
          }
        },
        "required": [
          "query",
          "search_mode"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "description": "Versioned knowledge record."
          },
          "effective_at": {
            "type": "string",
            "description": "Effective date or version."
          },
          "retrieved_at": {
            "type": "string",
            "description": "Retrieval timestamp when available."
          }
        },
        "required": [
          "record_id",
          "effective_at"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_card_account",
      "description": "Retrieve card status, available credit, recent authorizations, declines, restrictions, and travel notices in one account read.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "include": {
            "type": "array",
            "description": "Requested account sections.",
            "items": {
              "type": "string",
              "description": "Account section.",
              "enum": [
                "status",
                "available_credit",
                "authorizations",
                "declines",
                "restrictions",
                "travel_notices"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Card last four."
          },
          "status": {
            "type": "string",
            "description": "Card status."
          },
          "available_credit": {
            "type": "number",
            "description": "Available credit."
          },
          "authorizations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "declines": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "pending_activity": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "customer_id",
          "card_last4"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "resolve_card_restriction",
      "description": "Remove a temporary card restriction after the customer confirms the triggering activity.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "restriction_id": {
            "type": "string",
            "description": "Restriction to resolve."
          },
          "confirmed_transaction_ids": {
            "type": "array",
            "description": "Transactions the customer confirmed.",
            "items": {
              "type": "string",
              "description": "Transaction identifier."
            },
            "minItems": 1
          }
        },
        "required": [
          "customer_id",
          "restriction_id",
          "confirmed_transaction_ids"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Restriction outcome."
          },
          "card_status": {
            "type": "string",
            "description": "Resulting card status."
          },
          "effective_at": {
            "type": "string",
            "description": "Mutation time when available."
          }
        },
        "required": [
          "status",
          "card_status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "create_travel_notice",
      "description": "Add a travel notice without promising that every future authorization will be approved.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "destinations": {
            "type": "array",
            "description": "Travel destinations.",
            "items": {
              "type": "string",
              "description": "City, region, or country."
            },
            "minItems": 1
          },
          "return_date": {
            "type": "string",
            "description": "Customer-stated return date."
          }
        },
        "required": [
          "customer_id",
          "destinations",
          "return_date"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Creation outcome."
          },
          "notice_id": {
            "type": "string",
            "description": "Travel-notice identifier."
          },
          "authorization_guaranteed": {
            "type": "boolean",
            "description": "Whether the notice guarantees authorization."
          }
        },
        "required": [
          "status",
          "authorization_guaranteed"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_referrals",
      "description": "Retrieve referral invitations, offer terms, qualification state, and posting state without exposing the referred person's private transactions.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Referring customer identifier."
          },
          "referral_id": {
            "type": "string",
            "description": "Optional referral identifier."
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "referrals": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "referrals"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_credit_card_transactions",
      "description": "Retrieve candidate credit-card transactions for a verified customer using amount, descriptor, date, or card filters.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Optional last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "amount": {
            "type": "number",
            "description": "Optional exact transaction amount.",
            "minimum": 0
          },
          "descriptor_contains": {
            "type": "string",
            "description": "Optional descriptor text."
          },
          "posted_date": {
            "type": "string",
            "description": "Optional posted date or customer-relative date."
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "transactions"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "create_secure_self_service_session",
      "description": "Issue a secure customer-controlled workflow session. Issuing a session does not submit an application or claim.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "workflow": {
            "type": "string",
            "description": "Self-service workflow.",
            "enum": [
              "card_application",
              "referral_status",
              "transaction_dispute"
            ]
          },
          "resource_id": {
            "type": "string",
            "description": "Related product, referral, or transaction identifier."
          },
          "delivery_channels": {
            "type": "array",
            "description": "Authorized delivery channels.",
            "items": {
              "type": "string",
              "description": "Delivery channel.",
              "enum": [
                "secure_message",
                "email_notification"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "customer_id",
          "workflow",
          "resource_id",
          "delivery_channels"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session identifier."
          },
          "status": {
            "type": "string",
            "description": "Issued-session state."
          },
          "deliveries": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "submitted": {
            "type": "boolean",
            "description": "Whether customer submitted the workflow."
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration time when available."
          }
        },
        "required": [
          "session_id",
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_secure_self_service_session",
      "description": "Read whether an issued self-service session is open, saved, submitted, expired, or closed.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "session_id": {
            "type": "string",
            "description": "Self-service session identifier."
          }
        },
        "required": [
          "customer_id",
          "session_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session identifier."
          },
          "status": {
            "type": "string",
            "description": "Current session state."
          },
          "submitted": {
            "type": "boolean",
            "description": "Whether submitted."
          },
          "resume_supported": {
            "type": "boolean",
            "description": "Whether the customer can resume."
          },
          "expires_at": {
            "type": "string",
            "description": "Expiration time when available."
          }
        },
        "required": [
          "session_id",
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "send_secure_notification",
      "description": "Send a notification that points the customer to a secure in-account resource without placing a working secure link in ordinary email.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "related_resource_id": {
            "type": "string",
            "description": "Secure resource identifier."
          },
          "channel": {
            "type": "string",
            "description": "Notification channel.",
            "enum": [
              "email",
              "sms"
            ]
          },
          "template": {
            "type": "string",
            "description": "Approved notification template identifier."
          }
        },
        "required": [
          "customer_id",
          "related_resource_id",
          "channel",
          "template"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "description": "Notification identifier."
          },
          "status": {
            "type": "string",
            "description": "Notification state."
          },
          "masked_destination": {
            "type": "string",
            "description": "Masked destination."
          },
          "contains_working_secure_link": {
            "type": "boolean",
            "description": "Whether ordinary notification contains a working secure link."
          }
        },
        "required": [
          "notification_id",
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "transfer_to_specialist",
      "description": "Transfer the conversation with a concise reason and context summary when policy or tooling requires a specialist.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the transfer is required."
          },
          "summary": {
            "type": "string",
            "description": "Context already collected so the customer does not repeat it."
          }
        },
