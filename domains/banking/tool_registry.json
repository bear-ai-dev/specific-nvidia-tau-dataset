{
  "schema_version": "0.1.0",
  "registry_name": "banking",
  "registry_version": "0.1.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Stable entity reads and consequential business mutations; source narration labels are normalized rather than copied one-for-one.",
  "tools": [
    {
      "name": "lookup_customer",
      "description": "Find one banking customer using a stable customer identifier or verified profile attribute.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Customer account identifier."
          },
          "full_name": {
            "type": "string",
            "description": "Customer full name."
          },
          "email": {
            "type": "string",
            "description": "Email on the profile.",
            "format": "email"
          },
          "account_match": {
            "type": "string",
            "description": "Trusted calling-channel match when available.",
            "enum": [
              "caller_phone"
            ]
          },
          "billing_zip": {
            "type": "string",
            "description": "Billing ZIP collected for the lookup or verification."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits collected for the lookup or verification.",
            "pattern": "^[0-9]{4}$"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_current_time",
      "description": "Return the authoritative current timestamp for an audit or verification record.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "log_identity_verification",
      "description": "Record that the required identity checks succeeded; never store full card or one-time-code values in the call.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "methods": {
            "type": "array",
            "description": "Verification checks completed.",
            "items": {
              "type": "string",
              "description": "A verification method.",
              "enum": [
                "billing_zip",
                "mobile_last4",
                "date_of_birth",
                "one_time_code"
              ]
            },
            "minItems": 1
          },
          "verified_at": {
            "type": "string",
            "description": "Authoritative verification timestamp, if available."
          }
        },
        "required": [
          "customer_id",
          "methods"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_customer_email",
      "description": "Change the email on a verified customer profile after the required confirmation flow succeeds.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "new_email": {
            "type": "string",
            "description": "New customer email.",
            "format": "email"
          },
          "confirmation_method": {
            "type": "string",
            "description": "How the change was confirmed.",
            "enum": [
              "one_time_code",
              "secure_message",
              "in_person"
            ]
          }
        },
        "required": [
          "customer_id",
          "new_email",
          "confirmation_method"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_policy_knowledge",
      "description": "Search current product or policy knowledge. Search mode is an argument, not a separate business function.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Plain-language policy or product question."
          },
          "search_mode": {
            "type": "string",
            "description": "Retrieval strategy.",
            "enum": [
              "keyword",
              "semantic"
            ]
          },
          "as_of": {
            "type": "string",
            "description": "Optional date or timestamp for time-sensitive terms."
          }
        },
        "required": [
          "query",
          "search_mode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_card_account",
      "description": "Retrieve card status, available credit, recent authorizations, declines, restrictions, and travel notices in one account read.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "include": {
            "type": "array",
            "description": "Requested account sections.",
            "items": {
              "type": "string",
              "description": "Account section.",
              "enum": [
                "status",
                "available_credit",
                "authorizations",
                "declines",
                "restrictions",
                "travel_notices"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "resolve_card_restriction",
      "description": "Remove a temporary card restriction after the customer confirms the triggering activity.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "restriction_id": {
            "type": "string",
            "description": "Restriction to resolve."
          },
          "confirmed_transaction_ids": {
            "type": "array",
            "description": "Transactions the customer confirmed.",
            "items": {
              "type": "string",
              "description": "Transaction identifier."
            },
            "minItems": 1
          }
        },
        "required": [
          "customer_id",
          "restriction_id",
          "confirmed_transaction_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_travel_notice",
      "description": "Add a travel notice without promising that every future authorization will be approved.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "destinations": {
            "type": "array",
            "description": "Travel destinations.",
            "items": {
              "type": "string",
              "description": "City, region, or country."
            },
            "minItems": 1
          },
          "return_date": {
            "type": "string",
            "description": "Customer-stated return date."
          }
        },
        "required": [
          "customer_id",
          "destinations",
          "return_date"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_referrals",
      "description": "Retrieve referral invitations, offer terms, qualification state, and posting state without exposing the referred person's private transactions.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Referring customer identifier."
          },
          "referral_id": {
            "type": "string",
            "description": "Optional referral identifier."
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_credit_card_transactions",
      "description": "Retrieve candidate credit-card transactions for a verified customer using amount, descriptor, date, or card filters.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "card_last4": {
            "type": "string",
            "description": "Optional last four card digits.",
            "pattern": "^[0-9]{4}$"
          },
          "amount": {
            "type": "number",
            "description": "Optional exact transaction amount.",
            "minimum": 0
          },
          "descriptor_contains": {
            "type": "string",
            "description": "Optional descriptor text."
          },
          "posted_date": {
            "type": "string",
            "description": "Optional posted date or customer-relative date."
          }
        },
        "required": [
          "customer_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_secure_self_service_session",
      "description": "Issue a secure customer-controlled workflow session. Issuing a session does not submit an application or claim.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "workflow": {
            "type": "string",
            "description": "Self-service workflow.",
            "enum": [
              "card_application",
              "referral_status",
              "transaction_dispute"
            ]
          },
          "resource_id": {
            "type": "string",
            "description": "Related product, referral, or transaction identifier."
          },
          "delivery_channels": {
            "type": "array",
            "description": "Authorized delivery channels.",
            "items": {
              "type": "string",
              "description": "Delivery channel.",
              "enum": [
                "secure_message",
                "email_notification"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "customer_id",
          "workflow",
          "resource_id",
          "delivery_channels"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_secure_self_service_session",
      "description": "Read whether an issued self-service session is open, saved, submitted, expired, or closed.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "session_id": {
            "type": "string",
            "description": "Self-service session identifier."
          }
        },
        "required": [
          "customer_id",
          "session_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "send_secure_notification",
      "description": "Send a notification that points the customer to a secure in-account resource without placing a working secure link in ordinary email.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "related_resource_id": {
            "type": "string",
            "description": "Secure resource identifier."
          },
          "channel": {
            "type": "string",
            "description": "Notification channel.",
            "enum": [
              "email",
              "sms"
            ]
          },
          "template": {
            "type": "string",
            "description": "Approved notification template identifier."
          }
        },
        "required": [
          "customer_id",
          "related_resource_id",
          "channel",
          "template"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "transfer_to_specialist",
      "description": "Transfer the conversation with a concise reason and context summary when policy or tooling requires a specialist.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the transfer is required."
          },
          "summary": {
            "type": "string",
            "description": "Context already collected so the customer does not repeat it."
          }
        },
        "required": [
          "reason",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  ]
}
