{
  "schema_version": "0.2.0",
  "registry_name": "retail",
  "registry_version": "0.2.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Stable entity reads and consequential business mutations; source narration labels are normalized rather than copied one-for-one.",
  "tools": [
    {
      "name": "lookup_customer",
      "description": "Find a retail customer and recent orders using a verified email or customer identifier.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email on the order.",
            "format": "email"
          },
          "customer_id": {
            "type": "string",
            "description": "Optional customer identifier."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier."
          },
          "match": {
            "type": "string",
            "description": "Lookup outcome."
          },
          "display_name": {
            "type": "string",
            "description": "Customer display name."
          },
          "recent_orders": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "customer_id",
          "match"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_order",
      "description": "Retrieve an order with items, fulfillment, carrier scans, payments, refunds, cases, and eligible resolutions.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Full or partial order reference accepted by the source system."
          },
          "customer_email": {
            "type": "string",
            "description": "Email on the order.",
            "format": "email"
          },
          "include": {
            "type": "array",
            "description": "Order sections to retrieve.",
            "items": {
              "type": "string",
              "description": "Order section.",
              "enum": [
                "items",
                "fulfillment",
                "carrier_scans",
                "payments",
                "refunds",
                "cases",
                "eligible_resolutions",
                "notifications"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "order_reference",
          "customer_email"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference."
          },
          "customer": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fulfillment": {
            "type": "object"
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "refunds": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "eligible_resolutions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "notifications": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "order_reference"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_product",
      "description": "Retrieve product variant, price, and inventory for replacement or fulfillment decisions.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "product_reference": {
            "type": "string",
            "description": "Product or order-item identifier."
          },
          "location_id": {
            "type": "string",
            "description": "Optional store, pickup, or distribution location."
          },
          "include_inventory": {
            "type": "boolean",
            "description": "Whether inventory is required."
          }
        },
        "required": [
          "product_reference",
          "include_inventory"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "product_reference": {
            "type": "string",
            "description": "Product reference."
          },
          "variant": {
            "type": "object"
          },
          "inventory": {
            "type": "object"
          }
        },
        "required": [
          "product_reference"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "open_delivery_trace",
      "description": "Open a missing-package or carrier investigation with the customer's requested resolution and timing constraints.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference."
          },
          "item_references": {
            "type": "array",
            "description": "Affected order items.",
            "items": {
              "type": "string",
              "description": "Order-item reference."
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "description": "Trace reason.",
            "enum": [
              "delivered_not_received",
              "stalled_tracking",
              "wrong_location"
            ]
          },
          "requested_resolution": {
            "type": "string",
            "description": "Customer preference when already chosen.",
            "enum": [
              "replacement",
              "refund",
              "locate_only",
              "undecided"
            ]
          },
          "needed_by": {
            "type": "string",
            "description": "Optional customer timing requirement."
          }
        },
        "required": [
          "order_reference",
          "item_references",
          "reason"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Case identifier."
          },
          "status": {
            "type": "string",
            "description": "Trace state."
          },
          "carrier_response_deadline": {
            "type": "string",
            "description": "Carrier deadline."
          },
          "replacement_created": {
            "type": "boolean",
            "description": "Whether replacement exists."
          },
          "eligibility_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string",
            "description": "Next supported action."
          }
        },
        "required": [
          "case_id",
          "status",
          "replacement_created"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "open_refund_trace",
      "description": "Open a payment investigation for a refund that lacks settlement confirmation; do not issue a duplicate refund while it is open.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference."
          },
          "return_reference": {
            "type": "string",
            "description": "Return reference."
          },
          "payment_reference": {
            "type": "string",
            "description": "Original payment reference or masked card token."
          },
          "amount": {
            "type": "number",
            "description": "Amount under review.",
            "minimum": 0
          }
        },
        "required": [
          "order_reference",
          "return_reference",
          "payment_reference",
          "amount"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Case identifier."
          },
          "status": {
            "type": "string",
            "description": "Trace state."
          },
          "review_window_business_days": {
            "type": "array",
            "description": "Review-window endpoints.",
            "items": {
              "type": "number",
              "description": "Business-day count."
            },
            "minItems": 0
          },
          "duplicate_refund_blocked": {
            "type": "boolean",
            "description": "Whether duplicate refund is blocked."
          },
          "return_evidence_attached": {
            "type": "boolean",
            "description": "Whether return evidence was attached."
          }
        },
        "required": [
          "case_id",
          "status",
          "review_window_business_days",
          "duplicate_refund_blocked"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "create_replacement_order",
      "description": "Create a replacement at the eligible original price and return the new order, delivery estimate, return disposition, and notification state.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Original order reference."
          },
          "item_references": {
            "type": "array",
            "description": "Items to replace.",
            "items": {
              "type": "string",
              "description": "Order-item reference."
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "description": "Replacement reason.",
            "enum": [
              "damaged",
              "defective",
              "missing",
              "wrong_item"
            ]
          },
          "fulfillment_method": {
            "type": "string",
            "description": "Requested fulfillment method.",
            "enum": [
              "ship_to_address",
              "store_pickup"
            ]
          },
          "fulfillment_location": {
            "type": "string",
            "description": "Address label or pickup location when known."
          }
        },
        "required": [
          "order_reference",
          "item_references",
          "reason",
          "fulfillment_method"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "replacement_order_reference": {
            "type": "string",
            "description": "Replacement order reference."
          },
          "status": {
            "type": "string",
            "description": "Creation state."
          },
          "balance_due": {
            "type": "number",
            "description": "Replacement balance due."
          },
          "fulfillment": {
            "type": "object"
          },
          "return_disposition": {
            "type": "object"
          },
          "notification": {
            "type": "object"
          }
        },
        "required": [
          "replacement_order_reference",
          "status",
          "balance_due",
          "fulfillment",
          "return_disposition"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "update_case",
      "description": "Add a note, customer preference, or supporting-information marker to an existing support case without changing its primary outcome.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Support case identifier."
          },
          "note": {
            "type": "string",
            "description": "Case note."
          },
          "requested_resolution": {
            "type": "string",
            "description": "Optional requested resolution."
          },
          "preferred_pickup_location": {
            "type": "string",
            "description": "Optional pickup preference."
          }
        },
        "required": [
          "case_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Case-update state."
          },
          "visible_to_next_reviewer": {
            "type": "boolean",
            "description": "Whether later reviewers see the update."
          },
          "pickup_guaranteed": {
            "type": "boolean",
            "description": "Whether pickup was guaranteed."
          },
          "fee_reimbursement_approved": {
            "type": "boolean",
            "description": "Whether fee reimbursement was approved."
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "send_case_notification",
      "description": "Send or resend an existing case summary to the verified contact associated with the case and return the actual delivery state.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Support case identifier."
          },
          "channel": {
            "type": "string",
            "description": "Notification channel.",
            "enum": [
              "email",
              "sms"
            ]
          },
          "destination_source": {
            "type": "string",
            "description": "Verified destination source.",
            "enum": [
              "order_contact",
              "verified_customer_contact"
            ]
          },
          "template": {
            "type": "string",
            "description": "Approved case-notification template.",
            "enum": [
              "delivery_trace_confirmation",
              "refund_trace_confirmation",
              "case_reference"
            ]
          }
        },
        "required": [
          "case_id",
          "channel",
          "destination_source",
          "template"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "description": "Notification identifier."
          },
          "status": {
            "type": "string",
            "description": "Notification state."
          },
          "masked_destination": {
            "type": "string",
            "description": "Masked verified destination."
          },
          "case_id": {
            "type": "string",
            "description": "Related case identifier."
          },
          "included_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sent_at": {
            "type": "string",
            "description": "Send time when available."
          }
        },
        "required": [
          "notification_id",
          "status",
          "case_id"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "transfer_to_specialist",
      "description": "Transfer the conversation with a concise reason and context summary when policy or tooling requires a specialist.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the transfer is required."
          },
          "summary": {
            "type": "string",
            "description": "Context already collected so the customer does not repeat it."
          }
        },
        "required": [
          "reason",
          "summary"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Transfer state."
          },
          "transfer_id": {
            "type": "string",
            "description": "Transfer identifier."
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    }
  ]
}
