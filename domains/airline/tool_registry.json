{
  "schema_version": "0.2.0",
  "registry_name": "airline",
  "registry_version": "0.2.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Production-shaped airport/search/quote/accessibility/authentication/certificate/booking boundaries; customer-side seat selection is not an agent mutation.",
  "tools": [
    {
      "name": "list_supported_airports",
      "description": "List airports supported for a destination area before recommending one.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "destination_area": {
            "type": "string",
            "description": "City, metro area, or landmark area the traveler needs to reach."
          }
        },
        "required": [
          "destination_area"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "airports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "recommended_airport_code": {
            "type": "string",
            "description": "Recommended airport."
          },
          "recommendation_basis": {
            "type": "string",
            "description": "Why it was recommended."
          },
          "retrieved_at": {
            "type": "string",
            "description": "Retrieval time."
          }
        },
        "required": [
          "airports",
          "recommended_airport_code",
          "recommendation_basis"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "search_flights",
      "description": "Search round-trip flight options for a fixed route, dates, traveler count, and stop limit.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "origin_airport": {
            "type": "string",
            "description": "Origin airport code."
          },
          "destination_airport": {
            "type": "string",
            "description": "Destination airport code."
          },
          "departure_date": {
            "type": "string",
            "description": "Customer-stated outbound date."
          },
          "return_date": {
            "type": "string",
            "description": "Customer-stated return date."
          },
          "traveler_count": {
            "type": "integer",
            "description": "Number of travelers.",
            "minimum": 1
          },
          "max_stops": {
            "type": "integer",
            "description": "Maximum stops per direction.",
            "minimum": 0,
            "maximum": 2
          },
          "max_layover_minutes": {
            "type": "number",
            "description": "Optional maximum acceptable connection time in minutes.",
            "minimum": 0
          }
        },
        "required": [
          "origin_airport",
          "destination_airport",
          "departure_date",
          "return_date",
          "traveler_count",
          "max_stops"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "search_id": {
            "type": "string",
            "description": "Flight-search identifier."
          },
          "outbound": {
            "type": "object"
          },
          "return": {
            "type": "object"
          },
          "fare_options": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "best_connection": {
            "type": "object"
          },
          "availability_checked_at": {
            "type": "string",
            "description": "Availability timestamp."
          },
          "expires_at": {
            "type": "string",
            "description": "Search expiration."
          }
        },
        "required": [
          "search_id"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "calculate_itinerary_price",
      "description": "Calculate fare, taxes, baggage, mobility-device treatment, and an optional insurance quote for an itinerary.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "outbound_flight_id": {
            "type": "string",
            "description": "Selected outbound flight identifier."
          },
          "return_flight_id": {
            "type": "string",
            "description": "Selected return flight identifier."
          },
          "traveler_count": {
            "type": "integer",
            "description": "Number of travelers.",
            "minimum": 1
          },
          "fare_class": {
            "type": "string",
            "description": "Fare family to quote.",
            "enum": [
              "basic_economy",
              "standard_economy"
            ]
          },
          "checked_bag_count": {
            "type": "integer",
            "description": "Paid checked bags.",
            "minimum": 0
          },
          "mobility_device_count": {
            "type": "integer",
            "description": "Mobility devices recorded separately from paid baggage.",
            "minimum": 0
          },
          "include_insurance_quote": {
            "type": "boolean",
            "description": "Whether to return the optional insurance price."
          }
        },
        "required": [
          "outbound_flight_id",
          "return_flight_id",
          "traveler_count",
          "fare_class",
          "checked_bag_count",
          "mobility_device_count",
          "include_insurance_quote"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "description": "Quote identifier."
          },
          "fare_taxes_and_checked_bags": {
            "type": "number",
            "description": "Fare, taxes, and paid bags."
          },
          "mobility_device_charge": {
            "type": "number",
            "description": "Mobility-device charge."
          },
          "trip_insurance": {
            "type": "number",
            "description": "Insurance price."
          },
          "insurance_plan_document": {
            "type": "string",
            "description": "Plan document reference."
          },
          "total_with_insurance": {
            "type": "number",
            "description": "Final total with insurance."
          },
          "currency": {
            "type": "string",
            "description": "Currency."
          },
          "expires_at": {
            "type": "string",
            "description": "Quote expiration."
          }
        },
        "required": [
          "quote_id",
          "fare_taxes_and_checked_bags",
          "total_with_insurance",
          "currency"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "check_mobility_device_requirements",
      "description": "Return current fee, baggage-count, labeling, serial-number, and airport-notification rules for one mobility-device type.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "description": "Customer-stated mobility device."
          }
        },
        "required": [
          "device_type"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "device_type": {
            "type": "string",
            "description": "Device type."
          },
          "counts_as_paid_bag": {
            "type": "boolean",
            "description": "Whether counted as paid baggage."
          },
          "fee": {
            "type": "number",
            "description": "Device fee."
          },
          "serial_number_required": {
            "type": "boolean",
            "description": "Whether reservation entry needs a serial number."
          },
          "labeling_guidance": {
            "type": "string",
            "description": "Labeling guidance."
          },
          "airport_notification_required": {
            "type": "boolean",
            "description": "Whether airport notification is required."
          },
          "effective_at": {
            "type": "string",
            "description": "Rule version."
          }
        },
        "required": [
          "device_type",
          "counts_as_paid_bag",
          "fee",
          "serial_number_required"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_customer_profile",
      "description": "Retrieve a customer profile with selected reservation and masked payment sections.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Contact email on the customer profile.",
            "format": "email"
          },
          "include": {
            "type": "array",
            "description": "Profile sections to retrieve.",
            "items": {
              "type": "string",
              "enum": [
                "reservations",
                "payment_methods",
                "travel_certificates"
              ]
            },
            "minItems": 1
          },
          "verification_id": {
            "type": "string",
            "description": "Successful identity-verification record."
          }
        },
        "required": [
          "email",
          "include",
          "verification_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier."
          },
          "verification_id": {
            "type": "string",
            "description": "Verification record."
          },
          "duplicate_reservation": {
            "type": "boolean",
            "description": "Whether a duplicate exists."
          },
          "payment_methods": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "travel_certificate_input_required": {
            "type": "boolean",
            "description": "Whether certificate code is required."
          }
        },
        "required": [
          "customer_id",
          "verification_id",
          "duplicate_reservation"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "verify_customer_identity",
      "description": "Validate collected customer identity factors before reading stored reservations, payment methods, or certificates.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "description": "Customer full name."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Customer date of birth."
          },
          "email": {
            "type": "string",
            "description": "Customer email.",
            "format": "email"
          }
        },
        "required": [
          "full_name",
          "date_of_birth",
          "email"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "verification_id": {
            "type": "string",
            "description": "Verification identifier."
          },
          "status": {
            "type": "string",
            "description": "Verification status."
          },
          "customer_id": {
            "type": "string",
            "description": "Resolved customer."
          },
          "matched_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "description": "Verification expiry."
          }
        },
        "required": [
          "verification_id",
          "status",
          "customer_id",
          "matched_factors"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "book_reservation",
      "description": "Create an authorized reservation and return its confirmation, itinerary, ancillary products, and tender allocation.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "outbound_flight_id": {
            "type": "string",
            "description": "Selected outbound flight identifier."
          },
          "return_flight_id": {
            "type": "string",
            "description": "Selected return flight identifier."
          },
          "travelers": {
            "type": "array",
            "description": "Travelers exactly as supplied by the customer.",
            "items": {
              "type": "object",
              "properties": {
                "full_name": {
                  "type": "string",
                  "description": "Traveler full name."
                },
                "date_of_birth": {
                  "type": "string",
                  "description": "Traveler date of birth."
                }
              },
              "required": [
                "full_name",
                "date_of_birth"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "contact_email": {
            "type": "string",
            "description": "Reservation contact email.",
            "format": "email"
          },
          "fare_class": {
            "type": "string",
            "enum": [
              "basic_economy",
              "standard_economy"
            ]
          },
          "checked_bag_count": {
            "type": "integer",
            "minimum": 0
          },
          "mobility_devices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "include_trip_insurance": {
            "type": "boolean"
          },
          "payment_method_token": {
            "type": "string",
            "description": "Masked or tokenized remainder-payment method."
          },
          "confirmed_total": {
            "type": "number",
            "description": "Total authorized by the customer.",
            "minimum": 0
          },
          "customer_authorized": {
            "type": "boolean",
            "description": "Whether the customer authorized the itinerary, optional products, and stated total."
          },
          "verification_id": {
            "type": "string",
            "description": "Successful identity-verification record."
          },
          "quote_id": {
            "type": "string",
            "description": "Current itinerary quote identifier."
          },
          "certificate_id": {
            "type": "string",
            "description": "Validated certificate identifier."
          }
        },
        "required": [
          "customer_id",
          "outbound_flight_id",
          "return_flight_id",
          "travelers",
          "contact_email",
          "fare_class",
          "checked_bag_count",
          "mobility_devices",
          "include_trip_insurance",
          "payment_method_token",
          "confirmed_total",
          "customer_authorized",
          "verification_id",
          "quote_id",
          "certificate_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reservation_id": {
            "type": "string",
            "description": "Reservation identifier."
          },
          "confirmation_code": {
            "type": "string",
            "description": "Customer confirmation code."
          },
          "status": {
            "type": "string",
            "description": "Reservation status."
          },
          "ticketing_status": {
            "type": "string",
            "description": "Ticketing status."
          },
          "itinerary": {
            "type": "object"
          },
          "travelers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fare_class": {
            "type": "string",
            "description": "Booked fare family."
          },
          "checked_bag_count": {
            "type": "number",
            "description": "Paid checked bags."
          },
          "mobility_devices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "trip_insurance": {
            "type": "object"
          },
          "payment_allocation": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "payment_status": {
            "type": "string",
            "description": "Authorization or capture state."
          },
          "currency": {
            "type": "string",
            "description": "Currency."
          }
        },
        "required": [
          "reservation_id",
          "confirmation_code",
          "status",
          "payment_status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "validate_travel_certificate",
      "description": "Validate a customer-provided travel certificate and return a stable certificate ID, status, balance, and applicable amount before booking.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Resolved customer identifier."
          },
          "verification_id": {
            "type": "string",
            "description": "Successful identity-verification record."
          },
          "certificate_code": {
            "type": "string",
            "description": "Customer-provided certificate code."
          }
        },
        "required": [
          "customer_id",
          "verification_id",
          "certificate_code"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "certificate_id": {
            "type": "string",
            "description": "Certificate identifier."
          },
          "masked_code": {
            "type": "string",
            "description": "Masked certificate code."
          },
          "status": {
            "type": "string",
            "description": "Validation status."
          },
          "available_balance": {
            "type": "number",
            "description": "Available balance."
          },
          "applicable_amount": {
            "type": "number",
            "description": "Amount applicable to this quote."
          },
          "currency": {
            "type": "string",
            "description": "Currency."
          },
          "expires_at": {
            "type": "string",
            "description": "Certificate expiry when applicable."
          }
        },
        "required": [
          "certificate_id",
          "status",
          "available_balance",
          "applicable_amount",
          "currency"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "transfer_to_specialist",
      "description": "Transfer the conversation with a concise reason and context summary when policy or tooling requires a specialist.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the transfer is required."
          },
          "summary": {
            "type": "string",
            "description": "Context already collected so the customer does not repeat it."
          }
        },
        "required": [
          "reason",
          "summary"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Transfer status."
          },
          "transfer_id": {
            "type": "string",
            "description": "Transfer identifier."
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    }
  ]
}
