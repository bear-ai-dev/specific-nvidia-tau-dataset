{
  "schema_version": "0.2.0",
  "registry_name": "pharmacy",
  "registry_version": "0.2.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Stable entity reads and consequential business mutations; source narration labels are normalized rather than copied one-for-one.",
  "tools": [
    {
      "name": "lookup_patient",
      "description": "Resolve one pharmacy patient after collecting the required identity attributes.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string",
            "description": "Patient full name."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Patient date of birth."
          }
        },
        "required": [
          "full_name",
          "date_of_birth"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "string",
            "description": "Patient identifier."
          },
          "match": {
            "type": "string",
            "description": "Lookup outcome."
          },
          "verified_notification_destinations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "patient_id",
          "match"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_prescription",
      "description": "Retrieve a patient's prescription, claim, queue, and notification status.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "string",
            "description": "Resolved patient identifier."
          },
          "medication_name": {
            "type": "string",
            "description": "Medication name or description."
          }
        },
        "required": [
          "patient_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prescription_id": {
            "type": "string",
            "description": "Prescription identifier."
          },
          "medication_id": {
            "type": "string",
            "description": "Canonical medication identifier."
          },
          "fill_store": {
            "type": "object"
          },
          "claim": {
            "type": "object"
          },
          "queue": {
            "type": "object"
          },
          "notification": {
            "type": "object"
          },
          "payment_options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "prescription_id",
          "medication_id",
          "fill_store",
          "claim"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "request_claim_override",
      "description": "Request a payer decision for an eligible prescription-claim exception; the payer may require the patient to participate.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prescription_id": {
            "type": "string",
            "description": "Prescription identifier."
          },
          "reason": {
            "type": "string",
            "description": "Override reason.",
            "enum": [
              "lost_medication",
              "vacation_supply",
              "dose_change",
              "other"
            ]
          },
          "urgency_context": {
            "type": "string",
            "description": "Relevant timing supplied by the patient."
          }
        },
        "required": [
          "prescription_id",
          "reason"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "override_id": {
            "type": "string",
            "description": "Override identifier."
          },
          "status": {
            "type": "string",
            "description": "Payer decision."
          }
        },
        "required": [
          "override_id",
          "status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "submit_prescription_claim",
      "description": "Submit or rerun a prescription claim after any required override is approved.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prescription_id": {
            "type": "string",
            "description": "Prescription identifier."
          },
          "override_id": {
            "type": "string",
            "description": "Approved override identifier, when applicable."
          }
        },
        "required": [
          "prescription_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "claim_status": {
            "type": "string",
            "description": "Claim outcome."
          },
          "copay": {
            "type": "number",
            "description": "Patient copay."
          },
          "next_workflow_status": {
            "type": "string",
            "description": "Next prescription state."
          },
          "queue": {
            "type": "object"
          },
          "payment_options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "claim_status",
          "next_workflow_status"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_store_inventory",
      "description": "Check medication inventory at a specific pharmacy without reserving or transferring it.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "store_id": {
            "type": "string",
            "description": "Pharmacy location identifier."
          },
          "medication_id": {
            "type": "string",
            "description": "Medication/product identifier."
          }
        },
        "required": [
          "store_id",
          "medication_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "store_id": {
            "type": "string",
            "description": "Store identifier."
          },
          "medication_id": {
            "type": "string",
            "description": "Medication identifier."
          },
          "in_stock": {
            "type": "boolean",
            "description": "Inventory state."
          },
          "reserved": {
            "type": "boolean",
            "description": "Whether inventory was reserved."
          }
        },
        "required": [
          "store_id",
          "medication_id",
          "in_stock",
          "reserved"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "search_pharmacy_locations",
      "description": "Discover pharmacy locations and verified local hours before naming an alternate store or evaluating pickup timing.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "origin_store_id": {
            "type": "string",
            "description": "Current fill-store identifier when known."
          },
          "open_after_local_time": {
            "type": "string",
            "description": "Optional local time the counter must remain open after."
          },
          "query": {
            "type": "string",
            "description": "Optional customer-supplied location or store-name query."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "locations"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "request_prescription_transfer",
      "description": "Request transfer of a prescription after explicit patient authorization; a request does not imply completion.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prescription_id": {
            "type": "string",
            "description": "Prescription identifier."
          },
          "destination_store_id": {
            "type": "string",
            "description": "Destination pharmacy identifier returned by location search."
          },
          "reason": {
            "type": "string",
            "description": "Patient-provided transfer reason."
          },
          "patient_authorized": {
            "type": "boolean",
            "description": "Whether the patient explicitly authorized this transfer request."
          }
        },
        "required": [
          "prescription_id",
          "destination_store_id",
          "patient_authorized"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Transfer-request state."
          },
          "source_store_id": {
            "type": "string",
            "description": "Current store."
          },
          "destination_store_id": {
            "type": "string",
            "description": "Requested destination."
          },
          "original_fill_active": {
            "type": "boolean",
            "description": "Whether original fill remains active."
          }
        },
        "required": [
          "status",
          "destination_store_id"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "update_prescription",
      "description": "Update operational prescription fields such as priority context or notification channel; this cannot bypass pharmacist verification.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prescription_id": {
            "type": "string",
            "description": "Prescription identifier."
          },
          "priority_reason": {
            "type": "string",
            "description": "Optional operational priority context."
          },
          "notification_channel": {
            "type": "string",
            "description": "Optional ready-alert channel.",
            "enum": [
              "sms",
              "phone",
              "email"
            ]
          },
          "notification_destination_id": {
            "type": "string",
            "description": "Stable verified destination identifier returned by a prior patient or prescription read."
          }
        },
        "required": [
          "prescription_id"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Update outcome."
          },
          "updated_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notification": {
            "type": "object"
          },
          "queue": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "updated_fields"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "transfer_to_specialist",
      "description": "Transfer the conversation with a concise reason and context summary when policy or tooling requires a specialist.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the transfer is required."
          },
          "summary": {
            "type": "string",
            "description": "Context already collected so the customer does not repeat it."
          }
        },
        "required": [
          "reason",
          "summary"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Transfer state."
          },
          "transfer_id": {
            "type": "string",
            "description": "Transfer identifier."
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    }
  ]
}
